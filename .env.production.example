# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database Configuration
DB_USER=progress
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=progress_db

# NextAuth Configuration
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_nextauth_secret_here  # Generate with: openssl rand -base64 32

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# First-party OAuth server for the remote MCP endpoint
OAUTH_ISSUER=https://yourdomain.com
MCP_RESOURCE_URL=https://yourdomain.com/mcp
MCP_AUTH_REQUIRED_SCOPES=progress:read
OAUTH_KAIRO_CLIENT_ID=kairo
OAUTH_KAIRO_CLIENT_NAME=Kairo
OAUTH_KAIRO_REDIRECT_URIS=http://127.0.0.1:8765/callback
OAUTH_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OAUTH_SIGNING_KEY_ID=progress-oauth-1
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional: Email notifications (if you add this feature)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
