# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database Configuration
DB_USER=progress
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=progress_db

# NextAuth Configuration
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_nextauth_secret_here  # Generate with: openssl rand -base64 32

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Remote MCP OAuth resource server
MCP_RESOURCE_URL=https://yourdomain.com/mcp
MCP_AUTH_ISSUER=https://your-tenant.example.com/
MCP_AUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
MCP_AUTH_AUDIENCE=https://yourdomain.com/mcp
MCP_AUTH_REQUIRED_SCOPES=progress:read
MCP_AUTH_JWT_ALGORITHMS=RS256
MCP_AUTH_USER_ID_CLAIM=https://yourdomain.com/user_id
MCP_AUTH_ALLOW_EMAIL_LINKING=false

# Optional: Email notifications (if you add this feature)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
