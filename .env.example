# Database
# PostgreSQL connection string (Docker setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/progress_db?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Remote MCP OAuth resource server
# The authorization server must issue JWT access tokens whose audience is this URL.
MCP_RESOURCE_URL="http://localhost:3000/mcp"
MCP_AUTH_ISSUER="https://your-tenant.example.com/"
MCP_AUTH_JWKS_URL="https://your-tenant.example.com/.well-known/jwks.json"
MCP_AUTH_AUDIENCE="http://localhost:3000/mcp"
MCP_AUTH_REQUIRED_SCOPES="progress:read"
MCP_AUTH_JWT_ALGORITHMS="RS256"

# Preferred account linking: add the internal Progress user ID as a custom JWT claim.
# Example: https://progress.example.com/user_id
MCP_AUTH_USER_ID_CLAIM=""

# Migration fallback only. When enabled, a trusted issuer's verified email may be
# linked once to an existing Progress account, after which issuer + subject is used.
MCP_AUTH_ALLOW_EMAIL_LINKING="false"
