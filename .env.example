# Database
# PostgreSQL connection string (Docker setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/progress_db?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# First-party OAuth server for the remote MCP endpoint
OAUTH_ISSUER="http://localhost:3000"
MCP_RESOURCE_URL="http://localhost:3000/mcp"
MCP_AUTH_REQUIRED_SCOPES="progress:read"
OAUTH_KAIRO_CLIENT_ID="kairo"
OAUTH_KAIRO_CLIENT_NAME="Kairo"
OAUTH_KAIRO_REDIRECT_URIS="http://127.0.0.1:8765/callback"
# Generate a 2048-bit or stronger RSA private key. Use literal \n characters
# when the environment-variable provider does not support multiline values.
OAUTH_SIGNING_PRIVATE_KEY=""
OAUTH_SIGNING_KEY_ID="progress-oauth-1"
OAUTH_ACCESS_TOKEN_TTL_SECONDS="900"
OAUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"
